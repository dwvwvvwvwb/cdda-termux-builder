# --- cdda.sh (help text) ---
msgid ""
"Usage: ./cdda.sh [command] [options]\n"
"\n"
"Commands:\n"
"  setup [--yes]              Install system dependencies, NDK, and SDK.\n"
"  config [--yes] [tag]       Configure project (tag can be \"latest\" or a specific tag).\n"
"  build [--clean] [--yes]    Build APK (--clean cleans before build).\n"
"  all [--yes] [tag]          Run setup, config, build in sequence.\n"
"  clean                      Only clean build artifacts.\n"
"  lang [zh_CN|en]            Set or show the UI language.\n"
"  help                       Show this help.\n"
"\n"
"Environment:\n"
"  WORK_DIR        Source directory (default: ~/Cataclysm-DDA)\n"
"  BUILD_VARIANT   release or debug (default: release)\n"
"  NOTIFY          true/false (default: true)\n"
"  CDDA_LANG       UI language: en/zh_CN (default: auto-detect)\n"
"  GITHUB_TOKEN    Optional GitHub Personal Access Token\n"
"\n"
"Examples:\n"
"  ./cdda.sh all --yes latest\n"
"  ./cdda.sh config --yes cdda-experimental-2026-03-24-2310\n"
"  ./cdda.sh build --clean\n"
"  ./cdda.sh clean\n"
"  ./cdda.sh lang zh_CN"
msgstr ""
"用法: ./cdda.sh [命令] [选项]\n"
"\n"
"命令:\n"
"  setup [--yes]              安装系统依赖、NDK 和 SDK。\n"
"  config [--yes] [tag]       配置项目（tag 可以是 \"latest\" 或具体标签名）。\n"
"  build [--clean] [--yes]    构建 APK（--clean 可清理后构建）。\n"
"  all [--yes] [tag]          依次执行 setup, config, build。\n"
"  clean                      仅清理构建产物。\n"
"  lang [zh_CN|en]            设置或显示界面语言。\n"
"  help                       显示帮助。\n"
"\n"
"环境变量:\n"
"  WORK_DIR        源码目录（默认 ~/Cataclysm-DDA）\n"
"  BUILD_VARIANT   构建变体 release/debug（默认 release）\n"
"  NOTIFY          是否发送通知 true/false（默认 true）\n"
"  CDDA_LANG       界面语言 en/zh_CN（默认自动检测）\n"
"  GITHUB_TOKEN    可选的 GitHub Personal Access Token\n"
"\n"
"示例:\n"
"  ./cdda.sh all --yes latest\n"
"  ./cdda.sh config --yes cdda-experimental-2026-03-24-2310\n"
"  ./cdda.sh build --clean\n"
"  ./cdda.sh clean\n"
"  ./cdda.sh lang zh_CN"

